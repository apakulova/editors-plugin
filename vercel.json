{
  "buildCommand": "echo \"No build needed\"",
  "functions": {
    "api/queues/posthog.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "chistovik-analytics",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/daily-analytics",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/number-diagnostics",
      "destination": "/number-diagnostics.html"
    }
  ],
  "headers": [
    {
      "source": "/number-diagnostics",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "outputDirectory": "public"
}
